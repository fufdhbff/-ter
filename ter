// مدیریت Socket.io و اتصالات SSH
io.on('connection', (socket) => {
    let sshClient = null;

    socket.on('ssh-connect', (data) => {
        if (sshClient) sshClient.end();

        sshClient = new Client();
        const { host, port, username, password } = data;

        sshClient.on('ready', () => {
            socket.emit('status', 'اتصال برقرار شد! در حال دریافت Shell...');
            
            sshClient.shell({ term: 'xterm-256color' }, (err, stream) => {
                if (err) {
                    socket.emit('status', 'خطا در ایجاد Shell: ' + err.message);
                    return;
                }

                stream.on('data', (data) => {
                    socket.emit('terminal-output', data.toString('binary'));
                }).stderr.on('data', (data) => {
                    socket.emit('terminal-output', data.toString('binary'));
                });

                socket.on('terminal-input', (inputData) => {
                    stream.write(inputData);
                });

                stream.on('close', () => {
                    sshClient.end();
                    socket.emit('status', 'اتصال SSH قطع شد.');
                });
            });
        }).on('error', (err) => {
            socket.emit('status', 'خطا در اتصال: ' + err.message);
        }).connect({
            host: host,
            port: parseInt(port) || 22,
            username: username,
            password: password,
            readyTimeout: 20000
        });
    });

    socket.on('disconnect', () => {
        if (sshClient) sshClient.end();
    });
});

